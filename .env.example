# Public Supabase project URL (safe to expose in the browser).
VITE_SUPABASE_URL=https://your-project.supabase.co
# Public anon/publishable key (safe to expose; RLS protects database tables).
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase provides SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY to Edge Functions.
# Set these as Supabase Edge Function secrets, never as Vite variables:
# Set INBOX_EMAIL_DOMAIN only after you have a real, verified inbound domain.
# INBOX_EMAIL_DOMAIN=mail.yourdomain.com
# ALLOWED_ORIGIN=https://your-vercel-site.vercel.app
# INBOUND_WEBHOOK_SECRET=generate-a-long-random-secret
